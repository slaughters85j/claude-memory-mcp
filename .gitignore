# Dependencies
node_modules/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage
coverage/
*.lcov
.nyc_output/

# TypeScript cache
*.tsbuildinfo

# Optional caches
.npm/
.eslintcache

# Environment variables
.env
.env.local
.env.*.local

# ONNX / Transformers.js model cache
# Downloaded on first run (~80MB for all-MiniLM-L6-v2)
.cache/
node_modules/.cache/

# Hugging Face cache (alternative location for transformers models)
.hf_cache/

# LanceDB database files (user data - don't commit)
*.lance/
*.lancedb/
memory-db/
test-db/

# Sample docs (optional - users provide their own)
# Uncomment if you don't want to include sample PDFs
# sample-docs/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~

# IDEs and editors
.idea/
.vscode/
*.swp
*.swo
*.sublime-workspace
*.sublime-project

# Claude Code
.claude/

# Credentials (never commit)
*credentials*.json
*secrets*.json
*.pem
*.key

# Build artifacts that shouldn't be committed
# Note: dist/ IS committed for npm publishing
build/

# Test artifacts
tmp/
temp/

# Package tarballs
*.tgz
